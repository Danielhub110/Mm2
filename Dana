-- Find dropped gun model instance paths
local function locateGunDrop()
    local gun = Workspace:FindFirstChild("GunDrop")
    if gun then return gun end
    for _, v in ipairs(Workspace:GetChildren()) do
        if v:IsA("Folder") or v:IsA("Model") then
            local mapGun = v:FindFirstChild("GunDrop", true)
            if mapGun then return mapGun end
        end
    end
    return nil
end

-- FIXED LIVE WORKSPACE SCANNER: Scans your exact Spawns folder structure to determine true arena state
local function isCharacterInActiveArena()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local lobbyFolder = Workspace:FindFirstChild("Lobby")
    local spawnsFolder = lobbyFolder and lobbyFolder:FindFirstChild("Spawns")
    
    if spawnsFolder then
        for _, pad in ipairs(spawnsFolder:GetDescendants()) do
            if pad:IsA("BasePart") then
                local distance = (rootPart.Position - pad.Position).Magnitude
                if distance < 45 then 
                    return false
                end
            end
        end
    end

    local mainGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("MainGui")
    if mainGui and mainGui:FindFirstChild("Game") and mainGui.Game:FindFirstChild("RoundHint") then
        local roundText = mainGui.Game.RoundHint.Text
        if roundText:match("Lobby") or roundText:match("Intermission") or roundText:match("Voting") or roundText == "" then
            return false
        end
    end
    return true
end

