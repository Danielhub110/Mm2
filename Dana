-- Weapon projectile fire trigger hook
local function triggerGunShot(targetPos)
    local char = LocalPlayer.Character
    local gun = char and char:FindFirstChild("Gun")
    if gun and gun:FindFirstChild("KnifeLocal") and gun.KnifeLocal:FindFirstChild("CreateProjectile") then
        gun.KnifeLocal.CreateProjectile:FireServer(targetPos)
    end
end

-- HARD-LOCK MAXIMUM STRENGTH AIMLOCK TRACKING ENGINE WITH VARIABLE FOV COLORS
RunService.RenderStepped:Connect(function()
    if _G.Aimlock_Active then
        FOVCircleFrame.Visible = true
        FOVCircleFrame.Size = UDim2.new(0, _G.FOV_Radius * 2, 0, _G.FOV_Radius * 2)
        
        local targetChar = getMurdererCharacter()
        if targetChar then
            local rootPart = targetChar:FindFirstChild("HumanoidRootPart")
            local lockPart = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Head") 
            
            if lockPart and rootPart then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(lockPart.Position)
                
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distanceToCenter = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    
                    if distanceToCenter <= _G.FOV_Radius then
                        local predictedPosition = lockPart.Position + (rootPart.Velocity * 0.125) + Vector3.new(0, 0.1, 0)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPosition)
                        CircleStroke.Color = Color3.fromRGB(0, 255, 150) 
                        
                        if _G.AutoShoot_Enabled then
                            triggerGunShot(predictedPosition)
                        end
                        return
                    end
                end
            end
        end
        CircleStroke.Color = fovColorList[currentFovColorIndex]
    else
        FOVCircleFrame.Visible = false
    end
end)


