-- Dynamic candy and coin scanner framework update
local function getClosestCoin()
    local closestCoin = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and v.Parent and v.Parent:IsA("BasePart") then
                local item = v.Parent
                local pName = string.lower(item.Name)
                
                if string.find(pName, "coin") or string.find(pName, "candy") or string.find(pName, "sweet") or string.find(pName, "token") or item:FindFirstChild("CoinVisual") then
                    local distance = (item.Position - root.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestCoin = item
                    end
                end
            end
        end
    end
    return closestCoin
end

-- Pinpoint active Murderer character vectors
local function getMurdererCharacter()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local backpack = player:FindFirstChild("Backpack")
            local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
            
            if hasKnife and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                return char
            end
        end
    end
    return nil
end

-- Universal capacity sniffer
local function isCoinBagFull()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
    local gameUi = mainGui and mainGui:FindFirstChild("Game")
    
    if gameUi then
        for _, uiElement in ipairs(gameUi:GetDescendants()) do
            if uiElement:IsA("TextLabel") then
                local current, max = uiElement.Text:match("(%d+)%s*/%s*(%--%d+)")
                if current and max then
                    local currentCount = tonumber(current)
                    local maxCapacity = tonumber(max)
                    if currentCount and maxCapacity and currentCount >= maxCapacity then
                        return true
                    end
                end
            end
        end
    end

    if trackedCollectedAmount >= 40 then
        return true
    end

    local candyAttribute = LocalPlayer:GetAttribute("Candies") or LocalPlayer:GetAttribute("Candy") or LocalPlayer:GetAttribute("Coins") or LocalPlayer:GetAttribute("Coin")
    if candyAttribute and type(candyAttribute) == "number" and candyAttribute >= 40 then
        return true
    end

    return false
end

-- UNIFIED STABILIZED TWO-WAY TELEPORTATION ENGINE
local function teleportToGun()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local gunDrop = locateGunDrop()
    
    if character and root and gunDrop then
        _G.MemoryCFrame = root.CFrame
        root.Velocity = Vector3.new(0, 0, 0)
        root.RotVelocity = Vector3.new(0, 0, 0)
        root.CFrame = gunDrop:GetPivot() * CFrame.new(0, 1.5, 0)
        
        task.wait(0.2) 
        
        root.Velocity = Vector3.new(0, 0, 0)
        root.RotVelocity = Vector3.new(0, 0, 0)
        root.CFrame = _G.MemoryCFrame
        root.Anchored = true
        
        task.wait(0.15)
        root.Anchored = false
        _G.MemoryCFrame = nil
    else
        warn("Gun drop not found.")
    end
end

